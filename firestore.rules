rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── User playlists ───────────────────────────────────────────────
    // Each authenticated user can only read/write their own playlists.
    // Structure: users/{uid}/playlists/{playlistId}
    match /users/{uid}/playlists/{playlistId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }
    // ─── User Listening Events ──────────────────────────────────────────
    match /listening_events/{uid}/events/{eventId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }
    // ─── User Affinity Profiles ─────────────────────────────────────────
    match /user_affinity/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // ─── Block all other documents ────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
